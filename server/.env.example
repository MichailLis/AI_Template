DATABASE_URL=postgresql://user:password@localhost:5432/my_app_db?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider: any OpenAI-compatible API (Chat Completions + /models), called from the backend only.
# AI_PROVIDER: polza (default, https://polza.ai/api/v1) | openrouter | openai-compatible.
# AI_BASE_URL overrides the preset address and is required for openai-compatible.
# Keep AI_API_KEY only in local env files or host secrets.
AI_PROVIDER=polza
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_TIMEOUT_MS=120000
AI_PROF_ORIENTATION_TIMEOUT_MS=180000
AI_PROF_ORIENTATION_TIMEOUT_RETRIES=1
# OpenRouter only: attribution headers sent when AI_PROVIDER=openrouter.
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=AI Template Admin
