DATABASE_URL=postgresql://user:password@localhost:5432/my_app_db?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Optional OpenRouter integration. Keep this value only in local env files or host secrets.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=AI Template Admin
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_PROF_ORIENTATION_TIMEOUT_MS=180000
OPENROUTER_PROF_ORIENTATION_TIMEOUT_RETRIES=1
