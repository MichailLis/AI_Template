generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TestTopicVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestQuestionType {
  OPEN_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  SLIDER
}

enum TestStudentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum TestStudentAnalysisStatus {
  PENDING
  READY
  FAILED
}

enum TestStudentAnalysisProviderMode {
  STUB
  LLM
}

enum TestEntryProfileMode {
  DEMOGRAPHIC
  EDUCATION
  EDUCATION_DEMOGRAPHIC
}

enum TestPublicTemplate {
  STANDARD
  POLUS
}

enum TestStudentGender {
  MALE
  FEMALE
}

enum TestStudentEducationLevel {
  BASIC_GENERAL
  SECONDARY_GENERAL
  SECONDARY_SPECIAL
  INCOMPLETE_HIGHER_FROM_YEAR_3
  HIGHER
}

enum AnalysisPromptVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GroupOrClassValidationMode {
  NONE
  HINT
  STRICT
}

model User {
  id                 Int     @id @default(autoincrement())
  email              String  @unique
  name               String?
  password           String
  hashedRefreshToken String?
  role               Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdPublicTestLinks TestPublicLink[] @relation("PublicLinkCreatedBy")

  @@map("users")
}

model TestTopic {
  id                       Int       @id @default(autoincrement())
  slug                     String    @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  archivedAt               DateTime?
  activeDraftVersionId     Int?
  activePublishedVersionId Int?

  versions               TestTopicVersion[] @relation("TestTopicVersions")
  activeDraftVersion     TestTopicVersion?  @relation("ActiveDraftVersion", fields: [activeDraftVersionId], references: [id], onDelete: SetNull)
  activePublishedVersion TestTopicVersion?  @relation("ActivePublishedVersion", fields: [activePublishedVersionId], references: [id], onDelete: SetNull)

  @@index([archivedAt])
  @@map("test_topics")
}

model TestTopicVersion {
  id                      Int                    @id @default(autoincrement())
  topicId                 Int
  versionNumber           Int
  status                  TestTopicVersionStatus @default(DRAFT)
  title                   String
  description             String?
  analysisPromptVersionId Int?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  topic                 TestTopic              @relation("TestTopicVersions", fields: [topicId], references: [id], onDelete: Cascade)
  draftForTopic         TestTopic[]            @relation("ActiveDraftVersion")
  publishedForTopic     TestTopic[]            @relation("ActivePublishedVersion")
  analysisPromptVersion AnalysisPromptVersion? @relation(fields: [analysisPromptVersionId], references: [id], onDelete: SetNull)
  questions             TestQuestion[]
  publicLinks           TestPublicLink[]
  studentAttempts       TestStudentAttempt[]

  @@unique([topicId, versionNumber])
  @@index([topicId, status])
  @@index([analysisPromptVersionId])
  @@map("test_topic_versions")
}

model TestQuestion {
  id          Int              @id @default(autoincrement())
  versionId   Int
  type        TestQuestionType
  title       String
  description String?
  required    Boolean          @default(true)
  order       Int
  settings    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  version        TestTopicVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade)
  options        TestQuestionOption[]
  sliderBands    TestQuestionSliderBand[]
  studentAnswers TestStudentAnswer[]

  @@unique([versionId, order])
  @@map("test_questions")
}

model TestQuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  label      String
  value      String
  weight     Int      @default(0)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("test_question_options")
}

model TestQuestionSliderBand {
  id         Int    @id @default(autoincrement())
  questionId Int
  minValue   Int
  maxValue   Int
  label      String
  weight     Int    @default(0)
  order      Int

  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("test_question_slider_bands")
}

model TestPublicLink {
  id                      Int                  @id @default(autoincrement())
  topicVersionId          Int
  educationOrganizationId Int?
  shortCode               String               @unique
  isActive                Boolean              @default(true)
  startsAt                DateTime?
  endsAt                  DateTime?
  maxAttemptsPerStudent   Int                  @default(1)
  timeLimitMinutes        Int?
  allowResume             Boolean              @default(true)
  entryProfileMode        TestEntryProfileMode @default(EDUCATION)
  publicTemplate          TestPublicTemplate    @default(STANDARD)
  consentVersion          String
  consentTextSnapshot     String
  createdByUserId         Int?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  archivedAt              DateTime?

  topicVersion          TestTopicVersion       @relation(fields: [topicVersionId], references: [id], onDelete: Cascade)
  educationOrganization EducationOrganization? @relation(fields: [educationOrganizationId], references: [id], onDelete: SetNull)
  createdByUser         User?                  @relation("PublicLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attempts              TestStudentAttempt[]

  @@index([topicVersionId])
  @@index([educationOrganizationId])
  @@index([isActive])
  @@index([createdAt])
  @@map("test_public_links")
}

model EducationOrganization {
  id                     Int                        @id @default(autoincrement())
  name                   String                     @unique
  isActive               Boolean                    @default(true)
  groupValidationMode    GroupOrClassValidationMode @default(NONE)
  groupValidationPattern String?
  groupValidationExample String?
  groupValidationHint    String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  publicLinks TestPublicLink[]

  @@index([isActive])
  @@index([groupValidationMode])
  @@map("education_organizations")
}

model TestStudentAttempt {
  id                    Int                        @id @default(autoincrement())
  publicLinkId          Int
  topicVersionId        Int
  attemptNumber         Int
  status                TestStudentAttemptStatus   @default(IN_PROGRESS)
  studentName           String?
  studentLastInitial    String?
  studentMiddleInitial  String?
  educationOrganization String?
  groupOrClass          String?
  studentGender         TestStudentGender?
  studentAge            Int?
  studentResidence      String?
  studentEducationLevel TestStudentEducationLevel?
  studentKeyHash        String
  consentAcceptedAt     DateTime
  consentVersion        String
  consentTextSnapshot   String
  resumeToken           String                     @unique
  startedAt             DateTime                   @default(now())
  expiresAt             DateTime?
  finishedAt            DateTime?
  anonymizedAt          DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  publicLink   TestPublicLink       @relation(fields: [publicLinkId], references: [id], onDelete: Cascade)
  topicVersion TestTopicVersion     @relation(fields: [topicVersionId], references: [id], onDelete: Cascade)
  answers      TestStudentAnswer[]
  analysis     TestStudentAnalysis?

  @@unique([publicLinkId, studentKeyHash, attemptNumber])
  @@index([publicLinkId, studentKeyHash])
  @@index([status, startedAt])
  @@index([topicVersionId])
  @@map("test_student_attempts")
}

model TestStudentAnswer {
  id                    Int              @id @default(autoincrement())
  attemptId             Int
  questionId            Int
  questionTypeSnapshot  TestQuestionType
  questionTitleSnapshot String
  answerPayload         Json
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  attempt  TestStudentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TestQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("test_student_answers")
}

model TestStudentAnalysis {
  id              Int                             @id @default(autoincrement())
  attemptId       Int                             @unique
  promptVersionId Int?
  providerMode    TestStudentAnalysisProviderMode @default(STUB)
  status          TestStudentAnalysisStatus       @default(PENDING)
  summary         Json?
  rawText         String?
  errorMessage    String?
  generatedAt     DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  attempt       TestStudentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  promptVersion AnalysisPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([status, generatedAt])
  @@index([promptVersionId])
  @@map("test_student_analyses")
}

model AnalysisPrompt {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions AnalysisPromptVersion[]

  @@index([archivedAt])
  @@map("analysis_prompts")
}

model AnalysisPromptVersion {
  id            Int                         @id @default(autoincrement())
  promptId      Int
  versionNumber Int
  status        AnalysisPromptVersionStatus @default(DRAFT)
  model         String
  temperature   Float                       @default(0.2)
  prompt        String
  outputSchema  Json?
  publishedAt   DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  analysisPrompt  AnalysisPrompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  testVersions    TestTopicVersion[]
  studentAnalyses TestStudentAnalysis[]

  @@unique([promptId, versionNumber])
  @@index([promptId, status])
  @@index([status])
  @@map("analysis_prompt_versions")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
