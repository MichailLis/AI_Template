{
  "version": 1,
  "vectors": {
    "getMaxChoices": [
      {
        "description": "Standard positive integer cap",
        "input": {
          "maxChoices": 3
        },
        "expected": 3
      },
      {
        "description": "Single choice cap",
        "input": {
          "maxChoices": 1
        },
        "expected": 1
      },
      {
        "description": "Large integer cap",
        "input": {
          "maxChoices": 100
        },
        "expected": 100
      },
      {
        "description": "Zero cap is below 1 and must be rejected",
        "input": {
          "maxChoices": 0
        },
        "expected": null
      },
      {
        "description": "Negative integer cap is below 1 and must be rejected",
        "input": {
          "maxChoices": -1
        },
        "expected": null
      },
      {
        "description": "Fractional non-integer cap above 1 must be rejected",
        "input": {
          "maxChoices": 2.5
        },
        "expected": null
      },
      {
        "description": "Fractional non-integer cap below 1 must be rejected",
        "input": {
          "maxChoices": 0.5
        },
        "expected": null
      },
      {
        "description": "Negative fractional cap must be rejected",
        "input": {
          "maxChoices": -2.5
        },
        "expected": null
      },
      {
        "description": "String number cap must be rejected",
        "input": {
          "maxChoices": "3"
        },
        "expected": null
      },
      {
        "description": "Missing maxChoices in settings object",
        "input": {},
        "expected": null
      },
      {
        "description": "Settings with other fields but no maxChoices",
        "input": {
          "other": 42
        },
        "expected": null
      },
      {
        "description": "Settings is null",
        "input": null,
        "expected": null
      },
      {
        "description": "Settings is a primitive string",
        "input": "invalid-settings",
        "expected": null
      },
      {
        "description": "Settings is an array",
        "input": [],
        "expected": null
      }
    ],
    "matchesGroupPattern": [
      {
        "description": "Exact match against pattern",
        "input": {
          "value": "ИС-21",
          "pattern": "^ИС-\\d+$"
        },
        "expected": true
      },
      {
        "description": "Non-matching group code",
        "input": {
          "value": "БИ-21",
          "pattern": "^ИС-\\d+$"
        },
        "expected": false
      },
      {
        "description": "Unicode character matching with u flag",
        "input": {
          "value": "Группа-🎉",
          "pattern": "^Группа-\\p{Emoji}$"
        },
        "expected": true
      },
      {
        "description": "Invalid regular expression syntax falls back to true",
        "input": {
          "value": "любая группа",
          "pattern": "[invalid-unclosed"
        },
        "expected": true
      },
      {
        "description": "Empty string value matching wildcard pattern",
        "input": {
          "value": "",
          "pattern": ".*"
        },
        "expected": true
      },
      {
        "description": "Empty pattern matches any non-empty string",
        "input": {
          "value": "любая группа",
          "pattern": ""
        },
        "expected": true
      },
      {
        "description": "Case-sensitive mismatch",
        "input": {
          "value": "ис-21",
          "pattern": "^ИС-\\d+$"
        },
        "expected": false
      },
      {
        "description": "Prefix mismatch on anchored pattern",
        "input": {
          "value": "префикс-ИС-21",
          "pattern": "^ИС-\\d+$"
        },
        "expected": false
      },
      {
        "description": "Stored catastrophic pattern is not executed and falls back to true",
        "input": {
          "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa!",
          "pattern": "^(a+)+$"
        },
        "expected": true
      }
    ],
    "isSafeGroupPattern": [
      {
        "description": "Anchored class pattern",
        "input": "^ИС-\\d+$",
        "expected": true
      },
      {
        "description": "Group with alternation and no repeat",
        "input": "^(ИС|БИ)-\\d{2}$",
        "expected": true
      },
      {
        "description": "Optional group around a repeat is not a repeated group",
        "input": "^(\\d+-)?[А-Я]+$",
        "expected": true
      },
      {
        "description": "Exact repeat of a group with bounded inner repeat",
        "input": "^(\\d{2}){2}$",
        "expected": true
      },
      {
        "description": "Nested quantifiers",
        "input": "^(a+)+$",
        "expected": false
      },
      {
        "description": "Nested quantifiers through an inner group",
        "input": "^((\\d+)-?)*$",
        "expected": false
      },
      {
        "description": "Repeated group with open-ended bound around a star",
        "input": "^(a*){2,}$",
        "expected": false
      },
      {
        "description": "Quantifier inside a character class is not a repeat",
        "input": "^([+*]x)+$",
        "expected": true
      },
      {
        "description": "Escaped parenthesis is not a group",
        "input": "^\\(\\d+\\)+$",
        "expected": true
      },
      {
        "description": "Pattern longer than 300 characters",
        "input": "^$",
        "expected": false
      }
    ],
    "isValidInn": [
      { "description": "Legal entity INN, 10 digits", "input": "7707083893", "expected": true },
      { "description": "Individual INN, 12 digits", "input": "500100732259", "expected": true },
      { "description": "Nine digits", "input": "770708389", "expected": false },
      { "description": "Eleven digits", "input": "77070838931", "expected": false },
      { "description": "Letters among digits", "input": "77070838a3", "expected": false },
      { "description": "Spaces inside", "input": "7707 083893", "expected": false },
      { "description": "Empty string", "input": "", "expected": false }
    ],
    "isValidOgrn": [
      { "description": "Legal entity OGRN, 13 digits", "input": "1027700132195", "expected": true },
      {
        "description": "Individual entrepreneur OGRNIP, 15 digits",
        "input": "304500116000157",
        "expected": true
      },
      { "description": "Twelve digits", "input": "102770013219", "expected": false },
      { "description": "Fourteen digits", "input": "10277001321950", "expected": false },
      { "description": "Letters among digits", "input": "10277001321a5", "expected": false },
      { "description": "Dashes inside", "input": "1-02-77-00-13219", "expected": false },
      { "description": "Empty string", "input": "", "expected": false }
    ],
    "normalizeProfessionTitle": [
      {
        "description": "Standard multi-word profession title without special characters",
        "input": "Инженер-конструктор",
        "expected": "инженер-конструктор"
      },
      {
        "description": "Profession title with lowercase letter yo (ё)",
        "input": "Монтёр радиоэлектронной аппаратуры",
        "expected": "монтер радиоэлектронной аппаратуры"
      },
      {
        "description": "Profession title with leading and trailing whitespace",
        "input": "   Агроном   ",
        "expected": "агроном"
      },
      {
        "description": "Profession title with multiple consecutive whitespace characters",
        "input": "Инженер    по    качеству",
        "expected": "инженер по качеству"
      },
      {
        "description": "Profession title in uppercase",
        "input": "ВРАЧ-ПЕДИАТР",
        "expected": "врач-педиатр"
      },
      {
        "description": "Empty string",
        "input": "",
        "expected": ""
      },
      {
        "description": "Profession title with uppercase YO (Ё) and multiple occurrences",
        "input": "Ёмкостный аппаратчик и самолётостроитель",
        "expected": "емкостный аппаратчик и самолетостроитель"
      },
      {
        "description": "Whitespace-only string",
        "input": "   \t   ",
        "expected": ""
      }
    ],
    "getProfOrientationLlmStatus": [
      {
        "description": "Successful enrichment reports the LLM phase as ready",
        "input": {
          "resultKind": "prof_orientation_v3_plus",
          "llm": {
            "status": "ready"
          }
        },
        "expected": "ready"
      },
      {
        "description": "Algorithmic phase written with a prompt version leaves the LLM phase pending",
        "input": {
          "resultKind": "prof_orientation_v3_plus",
          "llm": {
            "status": "pending"
          }
        },
        "expected": "pending"
      },
      {
        "description": "Failed enrichment stays visible even though the record status remains READY",
        "input": {
          "resultKind": "prof_orientation_v3_plus",
          "llm": {
            "status": "failed"
          }
        },
        "expected": "failed"
      },
      {
        "description": "Topic version without a prompt version never requests the LLM phase",
        "input": {
          "resultKind": "prof_orientation_v3_plus",
          "llm": {
            "status": "not_requested"
          }
        },
        "expected": "not_requested"
      },
      {
        "description": "Summary without an llm block falls back to not_requested",
        "input": {
          "resultKind": "prof_orientation_v3_plus"
        },
        "expected": "not_requested"
      },
      {
        "description": "Unrecognised llm status falls back to not_requested",
        "input": {
          "resultKind": "prof_orientation_v3_plus",
          "llm": {
            "status": "queued"
          }
        },
        "expected": "not_requested"
      },
      {
        "description": "Non prof-orientation summary has no separate LLM phase",
        "input": {
          "resultKind": "standard_stub",
          "llm": {
            "status": "ready"
          }
        },
        "expected": null
      },
      {
        "description": "Absent summary has no separate LLM phase",
        "input": null,
        "expected": null
      },
      {
        "description": "Primitive summary has no separate LLM phase",
        "input": "prof_orientation_v3_plus",
        "expected": null
      }
    ]
  }
}
