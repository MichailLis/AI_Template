{
  "version": 1,
  "auth": {
    "requiredRoutes": ["/login"],
    "requiredBackendModule": "AuthModule"
  },
  "publicRoutes": [
    "/privacy",
    "/t/:code",
    "/t/:code/session/:sessionToken",
    "/t/:code/result/:sessionToken"
  ],
  "generatedApiDirs": ["privacy-policy", "tests-public"],
  "integrationModules": [
    {
      "name": "openrouter",
      "backendModule": "OpenRouterModule",
      "ownership": {
        "kind": "integration",
        "owns": ["OpenRouter API client", "OpenRouter API key resolution"]
      },
      "ownedRoots": {
        "backend": ["server/src/openrouter"]
      },
      "backendFiles": [
        "server/src/openrouter/openrouter.module.ts",
        "server/src/openrouter/openrouter-api-key.service.ts",
        "server/src/openrouter/openrouter.client.ts",
        "server/src/openrouter/openrouter.utils.ts"
      ]
    }
  ],
  "features": [
    {
      "name": "admin",
      "route": "/admin",
      "additionalRoutes": ["/admin/users", "/admin/analytics", "/admin/settings"],
      "backendModule": "AdminModule",
      "prismaModel": "User",
      "schema": "adminOverviewSchema",
      "ownership": {
        "kind": "admin-shell",
        "owns": ["admin shell", "users", "settings"],
        "routeNamespaceNote": "/admin/* hosts protected operator UI; routes under it can belong to other features."
      },
      "verification": {
        "requireOwnedRoots": true,
        "requireOpenApiOperations": true
      },
      "openApiInventoryPrefixes": ["/admin"],
      "ownedRoots": {
        "backend": ["server/src/admin", "server/src/app-settings"],
        "frontend": [
          "client/src/features/admin",
          "client/src/widgets/admin-page-layout",
          "client/src/widgets/admin-settings-workspace",
          "client/src/widgets/admin-users-workspace"
        ]
      },
      "backendFiles": [
        "server/src/admin/admin.module.ts",
        "server/src/admin/admin.controller.ts",
        "server/src/admin/admin-settings.controller.ts",
        "server/src/admin/admin.service.ts",
        "server/src/admin/dto/admin-overview-response.dto.ts",
        "server/src/admin/dto/admin-settings.dto.ts",
        "server/src/admin/dto/admin-users-query.dto.ts",
        "server/src/admin/dto/admin-user-response.dto.ts",
        "server/src/admin/dto/admin-users-response.dto.ts",
        "server/src/admin/dto/update-user-role.dto.ts",
        "server/src/app-settings/profession-atlas-settings.service.ts"
      ],
      "frontendFiles": [
        "client/src/pages/admin/admin-page.tsx",
        "client/src/pages/admin/admin-users-page.tsx",
        "client/src/pages/admin/admin-analytics-page.tsx",
        "client/src/pages/admin/admin-settings-page.tsx",
        "client/src/features/admin/ui/admin-shell.tsx",
        "client/src/shared/ui/table.tsx",
        "client/src/shared/ui/badge.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/admin/admin.ts",
      "openApiOperations": [
        {
          "path": "/admin",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/users",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/users/{id}/role",
          "methods": ["patch"],
          "protected": true
        },
        {
          "path": "/admin/settings/openrouter",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/settings/profession-atlas",
          "methods": ["get", "patch"],
          "protected": true
        },
        {
          "path": "/admin/settings/profession-atlas/coverage",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/settings/privacy-policy",
          "methods": ["get", "patch"],
          "protected": true
        }
      ]
    },
    {
      "name": "analysis-prompts",
      "route": "/admin/prompts",
      "backendModule": "AnalysisPromptsModule",
      "prismaModel": "AnalysisPrompt",
      "schema": "adminPromptGenerateSchema",
      "ownership": {
        "kind": "product-feature",
        "owns": ["analysis prompt lifecycle", "prompt simulation", "prompt model catalog proxy"],
        "adminRoutesAreUiHost": true
      },
      "verification": {
        "requireOwnedRoots": true,
        "requireOpenApiOperations": true
      },
      "openApiInventoryPrefixes": ["/admin/prompts"],
      "ownedRoots": {
        "backend": ["server/src/analysis-prompts"],
        "frontend": ["client/src/widgets/admin-prompts-workspace"]
      },
      "backendFiles": [
        "server/src/analysis-prompts/analysis-prompts.module.ts",
        "server/src/analysis-prompts/analysis-prompts.controller.ts",
        "server/src/analysis-prompts/analysis-prompts.service.ts",
        "server/src/analysis-prompts/dto/admin-prompt-models-response.dto.ts",
        "server/src/analysis-prompts/dto/admin-prompt-response.dto.ts",
        "server/src/analysis-prompts/dto/analysis-prompt.dto.ts",
        "server/src/analysis-prompts/dto/generate-prompt.dto.ts"
      ],
      "frontendFiles": [
        "client/src/pages/admin/admin-prompts-page.tsx",
        "client/src/widgets/admin-prompts-workspace/index.ts"
      ],
      "generatedApiFile": "client/src/shared/api/generated/admin/admin.ts",
      "openApiOperations": [
        {
          "path": "/admin/prompts",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/prompts/{promptId}",
          "methods": ["patch", "delete"],
          "protected": true
        },
        {
          "path": "/admin/prompts/models",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/prompts/generate",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/prompts/simulate",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/prompts/test-questions",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/prompts/versions/{versionId}/publish",
          "methods": ["post"],
          "protected": true
        }
      ]
    },
    {
      "name": "tests",
      "route": "/admin/tests",
      "additionalRoutes": [
        "/admin/public-links",
        "/admin/public-links/organizations",
        "/admin/public-links/stats"
      ],
      "backendModule": "TestsModule",
      "prismaModel": "TestTopic",
      "schema": "testsTopicCreateSchema",
      "ownership": {
        "kind": "product-feature",
        "owns": [
          "test authoring",
          "publishing",
          "public links",
          "education organizations for tests",
          "attempt/session/result flows",
          "public /t/* routes"
        ],
        "adminRoutesAreUiHost": true
      },
      "verification": {
        "requireOwnedRoots": true,
        "requireOpenApiOperations": true
      },
      "openApiInventoryPrefixes": ["/admin/tests", "/tests/public"],
      "ownedRoots": {
        "backend": ["server/src/tests"],
        "frontend": [
          "client/src/features/tests",
          "client/src/widgets/admin-tests-workspace",
          "client/src/widgets/admin-public-links-workspace",
          "client/src/widgets/admin-public-links-stats-workspace",
          "client/src/widgets/admin-education-organizations-workspace",
          "client/src/widgets/public-test-workspace",
          "client/src/pages/t"
        ]
      },
      "backendFiles": [
        "server/src/tests/tests.module.ts",
        "server/src/tests/tests-attempts.module.ts",
        "server/src/tests/topics/topics.module.ts",
        "server/src/tests/topics/topics.controller.ts",
        "server/src/tests/topics/topics.service.ts",
        "server/src/tests/public-links/public-links.module.ts",
        "server/src/tests/public-links/admin-public-links.controller.ts",
        "server/src/tests/public-links/admin-education-organizations.controller.ts",
        "server/src/tests/session/public.controller.ts",
        "server/src/tests/session/public-session.service.ts",
        "server/src/tests/analysis/prompt-simulation-read.module.ts",
        "server/src/tests/analysis/analysis.service.ts",
        "server/src/tests/reporting/admin-analytics.controller.ts",
        "server/src/tests/attempts/admin-attempts.controller.ts",
        "server/src/tests/dto/tests.dto.ts"
      ],
      "frontendFiles": [
        "client/src/pages/admin/admin-tests-page.tsx",
        "client/src/pages/admin/admin-public-links-page.tsx",
        "client/src/pages/admin/admin-public-links-stats-page.tsx",
        "client/src/pages/admin/admin-public-links-organizations-page.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/tests/tests.ts",
      "openApiOperations": [
        {
          "path": "/admin/tests",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}",
          "methods": ["delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/archive",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/restore",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/topics/{topicId}/analytics/summary",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/topics/{topicId}/analytics/export.xlsx",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/topics/{topicId}/analytics/export.pdf",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/ai/create",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/methodologies/prof-orientation-v3-plus/import",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft",
          "methods": ["get", "patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions/reorder",
          "methods": ["patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions/{questionId}",
          "methods": ["patch", "delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/publish",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/archived",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}",
          "methods": ["patch", "delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/regenerate",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/restore",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/education-organizations",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/education-organizations/{organizationId}",
          "methods": ["patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/attempts",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/attempts/{attemptId}",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/tests/public/links/{code}",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/links/{code}/start",
          "methods": ["post"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/answers",
          "methods": ["put"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/finish",
          "methods": ["post"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/result",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        }
      ]
    }
  ]
}
