{
  "version": 1,
  "auth": {
    "requiredRoutes": [
      "/login",
      "/register"
    ],
    "requiredBackendModule": "AuthModule"
  },
  "features": [
    {
      "name": "calculator",
      "route": "/calculator",
      "backendModule": "CalculatorModule",
      "prismaModel": "Calculation",
      "schema": "calculatorSchema",
      "backendFiles": [
        "server/src/calculator/calculator.module.ts",
        "server/src/calculator/calculator.controller.ts",
        "server/src/calculator/calculator.service.ts"
      ],
      "frontendFiles": [
        "client/src/features/calculator/calculator-widget.tsx",
        "client/src/features/calculator/history-list.tsx",
        "client/src/pages/calculator/index.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/calculator/calculator.ts"
    },
    {
      "name": "notes",
      "route": "/notes",
      "backendModule": "NotesModule",
      "prismaModel": "Note",
      "schema": "createNoteSchema",
      "backendFiles": [
        "server/src/notes/notes.module.ts",
        "server/src/notes/notes.controller.ts",
        "server/src/notes/notes.service.ts"
      ],
      "frontendFiles": [
        "client/src/features/notes/create-note-form.tsx",
        "client/src/features/notes/notes-list.tsx",
        "client/src/pages/notes/index.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/notes/notes.ts"
    },
    {
      "name": "tasks",
      "route": "/tasks",
      "backendModule": "TasksModule",
      "prismaModel": "Task",
      "schema": "createTaskSchema",
      "backendFiles": [
        "server/src/tasks/tasks.module.ts",
        "server/src/tasks/tasks.controller.ts",
        "server/src/tasks/tasks.service.ts"
      ],
      "frontendFiles": [
        "client/src/features/tasks/create-task-form.tsx",
        "client/src/features/tasks/tasks-list.tsx",
        "client/src/pages/tasks/index.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/tasks/tasks.ts"
    },
    {
      "name": "bookmarks",
      "route": "/bookmarks",
      "backendModule": "BookmarksModule",
      "prismaModel": "Bookmark",
      "schema": "bookmarkSchema",
      "backendFiles": [
        "server/src/bookmarks/bookmarks.module.ts",
        "server/src/bookmarks/bookmarks.controller.ts",
        "server/src/bookmarks/bookmarks.service.ts"
      ],
      "frontendFiles": [
        "client/src/features/bookmarks/create-bookmark-form.tsx",
        "client/src/features/bookmarks/bookmarks-list.tsx",
        "client/src/pages/bookmarks/index.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/bookmarks/bookmarks.ts"
    }
  ]
}
