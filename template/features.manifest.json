{
  "version": 1,
  "auth": {
    "requiredRoutes": ["/login"],
    "requiredBackendModule": "AuthModule"
  },
  "publicRoutes": ["/t/:code", "/t/:code/session/:sessionToken", "/t/:code/result/:sessionToken"],
  "generatedApiDirs": ["tests-public"],
  "features": [
    {
      "name": "admin",
      "route": "/admin",
      "backendModule": "AdminModule",
      "prismaModel": "User",
      "schema": "adminOverviewSchema",
      "ownership": {
        "kind": "admin-shell",
        "owns": ["admin shell", "overview", "users", "settings"],
        "routeNamespaceNote": "/admin/* hosts protected operator UI; routes under it can belong to other features.",
        "candidateExtractions": ["analysis-prompts"]
      },
      "backendFiles": [
        "server/src/admin/admin.module.ts",
        "server/src/admin/admin.controller.ts",
        "server/src/admin/admin.service.ts",
        "server/src/admin/dto/admin-overview-response.dto.ts",
        "server/src/admin/dto/admin-prompt-models-response.dto.ts",
        "server/src/admin/dto/admin-prompt-response.dto.ts",
        "server/src/admin/dto/admin-users-query.dto.ts",
        "server/src/admin/dto/admin-user-response.dto.ts",
        "server/src/admin/dto/admin-users-response.dto.ts",
        "server/src/admin/dto/generate-prompt.dto.ts",
        "server/src/admin/dto/update-user-role.dto.ts",
        "server/src/openrouter/openrouter.module.ts",
        "server/src/openrouter/openrouter-api-key.service.ts"
      ],
      "frontendFiles": [
        "client/src/pages/admin/admin-page.tsx",
        "client/src/pages/admin/admin-overview-page.tsx",
        "client/src/pages/admin/admin-users-page.tsx",
        "client/src/pages/admin/admin-analytics-page.tsx",
        "client/src/pages/admin/admin-prompts-page.tsx",
        "client/src/features/admin/ui/admin-shell.tsx",
        "client/src/features/admin/ui/admin-overview.tsx",
        "client/src/shared/ui/table.tsx",
        "client/src/shared/ui/badge.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/admin/admin.ts"
    },
    {
      "name": "tests",
      "route": "/admin/tests",
      "backendModule": "TestsModule",
      "prismaModel": "TestTopic",
      "schema": "testsTopicCreateSchema",
      "ownership": {
        "kind": "product-feature",
        "owns": [
          "test authoring",
          "publishing",
          "public links",
          "education organizations for tests",
          "attempt/session/result flows",
          "public /t/* routes"
        ],
        "adminRoutesAreUiHost": true
      },
      "verification": {
        "requireOwnedRoots": true,
        "requireOpenApiOperations": true
      },
      "ownedRoots": {
        "backend": ["server/src/tests"],
        "frontend": [
          "client/src/features/tests",
          "client/src/widgets/admin-tests-workspace",
          "client/src/widgets/admin-public-links-workspace",
          "client/src/widgets/admin-public-links-stats-workspace",
          "client/src/widgets/admin-education-organizations-workspace",
          "client/src/widgets/public-test-workspace",
          "client/src/pages/t"
        ]
      },
      "backendFiles": [
        "server/src/tests/tests.module.ts",
        "server/src/tests/tests.controller.ts",
        "server/src/tests/tests.service.ts",
        "server/src/tests/dto/tests.dto.ts"
      ],
      "frontendFiles": [
        "client/src/pages/admin/admin-tests-page.tsx",
        "client/src/pages/admin/admin-public-links-page.tsx",
        "client/src/pages/admin/admin-public-links-stats-page.tsx",
        "client/src/pages/admin/admin-public-links-organizations-page.tsx",
        "client/src/features/admin/ui/admin-shell.tsx"
      ],
      "generatedApiFile": "client/src/shared/api/generated/tests/tests.ts",
      "openApiOperations": [
        {
          "path": "/admin/tests",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}",
          "methods": ["delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/archive",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/restore",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/ai/create",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/methodologies/prof-orientation-v3-plus/import",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft",
          "methods": ["get", "patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions/reorder",
          "methods": ["patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/draft/questions/{questionId}",
          "methods": ["patch", "delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/{topicId}/publish",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/archived",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}",
          "methods": ["patch", "delete"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/regenerate",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/restore",
          "methods": ["post"],
          "protected": true
        },
        {
          "path": "/admin/tests/education-organizations",
          "methods": ["get", "post"],
          "protected": true
        },
        {
          "path": "/admin/tests/education-organizations/{organizationId}",
          "methods": ["patch"],
          "protected": true
        },
        {
          "path": "/admin/tests/public-links/{linkId}/attempts",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/admin/tests/attempts/{attemptId}",
          "methods": ["get"],
          "protected": true
        },
        {
          "path": "/tests/public/links/{code}",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/links/{code}/start",
          "methods": ["post"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/answers",
          "methods": ["put"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/finish",
          "methods": ["post"],
          "errorStatuses": ["400", "404"]
        },
        {
          "path": "/tests/public/sessions/{sessionToken}/result",
          "methods": ["get"],
          "errorStatuses": ["400", "404"]
        }
      ]
    }
  ]
}
