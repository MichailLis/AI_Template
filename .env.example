# Optional local overrides for root docker-compose.yml.
# Copy to .env only when the default local Docker values are not enough.

DATABASE_URL=postgresql://user:password@postgres:5432/my_app_db?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=AI Template Admin
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_PROF_ORIENTATION_TIMEOUT_MS=180000
OPENROUTER_PROF_ORIENTATION_TIMEOUT_RETRIES=1
VITE_API_URL=http://localhost:3000
