{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(rtk:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run test:*)",
      "Bash(npm run gen:*)",
      "Bash(npm run format:check:*)",
      "Bash(npm run prisma:generate:*)",
      "Bash(npm --prefix client run:*)",
      "Bash(npm --prefix server run:*)",
      "Bash(npm outdated:*)",
      "Bash(npm audit:*)",
      "Bash(node -e:*)",
      "Bash(node --test:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(echo:*)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__find_implementations",
      "mcp__serena__find_declaration",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__search_for_pattern",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__activate_project"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(npm run prisma:push:*)",
      "Bash(npm run prisma:seed:*)",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__replace_symbol_body"
    ]
  },
  "enabledMcpjsonServers": ["serena"],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-write-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
