# Env-файл для CI-проверки прод-образов (job "Prod stack smoke", scripts/e2e-prod-stack.mjs).
# Все значения ЯВНО фейковые и живут только в одноразовом стеке job: настоящих секретов здесь нет.
# Проходят validateEnv в прод-режиме: без "change-me", без user/password в DATABASE_URL.

DOCKERHUB_NAMESPACE=ci-local
APP_IMAGE_TAG=ci

# Нестандартные порты и имена, чтобы локальный прогон не задел dev-стек ai_template_*.
APP_HTTP_PORT=18080
ADMINER_PORT=18081
POSTGRES_CONTAINER_NAME=ai_template_ci_postgres
ADMINER_CONTAINER_NAME=ai_template_ci_adminer
BACKEND_CONTAINER_NAME=ai_template_ci_backend
FRONTEND_CONTAINER_NAME=ai_template_ci_frontend
POSTGRES_VOLUME_NAME=ai_template_ci_postgres_data
BACKUPS_VOLUME_NAME=ai_template_ci_backups

POSTGRES_USER=ci_smoke
POSTGRES_PASSWORD=ci-smoke-db-pass-0000
POSTGRES_DB=ci_smoke
DATABASE_URL=postgresql://ci_smoke:ci-smoke-db-pass-0000@postgres:5432/ci_smoke?schema=public

JWT_ACCESS_SECRET=ci-smoke-fake-access-secret-0000000000000000
JWT_REFRESH_SECRET=ci-smoke-fake-refresh-secret-000000000000000
# Адрес nginx, с которого браузер ходит в стек.
CORS_ALLOWED_ORIGINS=http://localhost:18080

RUN_DB_MIGRATIONS=true
BOOTSTRAP_ADMIN_EMAIL=ci-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ci-smoke-admin-pass-1
BOOTSTRAP_ADMIN_NAME=CI Admin
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# LLM не настроен: анализ остаётся алгоритмической заглушкой (STUB), наружу запросов нет.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_TIMEOUT_MS=120000
AI_PROF_ORIENTATION_TIMEOUT_MS=90000
AI_PROF_ORIENTATION_TIMEOUT_RETRIES=2
ANALYSIS_LLM_CONCURRENCY=3
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=AI Template Admin
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_COUNT=30
BACKUP_MAX_UPLOAD_MB=500
