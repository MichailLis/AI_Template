{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:container": "vite --host 0.0.0.0 --port 5173",
    "dev:force": "node -e \"const fs=require('node:fs');fs.rmSync('node_modules/.vite',{recursive:true,force:true});\" && vite --force",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b tsconfig.production.json tsconfig.node.json && vite build",
    "lint": "eslint .",
    "lint:staged": "eslint --fix --no-warn-ignored",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:api": "node -e \"const fs=require('node:fs');fs.rmSync('src/shared/api/generated',{recursive:true,force:true});fs.rmSync('src/shared/api/model',{recursive:true,force:true});\" && orval",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.107.1",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "orval": "8.47.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.1"
    },
    "js-yaml": "4.3.2",
    "minimatch": "11.0.3"
  }
}
