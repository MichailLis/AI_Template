{
  "name": "fullstack-project",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run start:dev --prefix server",
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "gen:nest": "npx nest g -c ./schematics/collection.json resource",
    "gen:api": "npm run gen:api --prefix client",
    "prisma:generate": "npx prisma generate --schema=./server/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "nestjs-zod": "^5.1.1",
    "zod": "^4.3.6"
  }
}
